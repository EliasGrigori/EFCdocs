{
  "name": "efcdocs",
  "version": "0.6.12",
  "private": true,
  "description": "EFCdocs: Planilha, Documento e Post-its (PWA). Código-fonte; o app publicado fica na raiz do repositório.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test testes/*/*.test.mjs",
    "test:regras": "node --test testes/*/*.test.mjs",
    "test:nucleo": "node --test testes/nucleo/*.test.mjs",
    "test:planilha": "node --test testes/planilha/*.test.mjs",
    "test:excel": "node --test testes/excel/*.test.mjs",
    "test:quadro": "node --test testes/quadro/*.test.mjs",
    "test:documento": "node --test testes/documento/*.test.mjs",
    "test:ferramentas": "node --test testes/ferramentas/*.test.mjs",
    "test:fidelidade": "node --test testes/fidelidade/fidelidade-comparar.test.mjs testes/fidelidade/rede-completa.mjs",
    "test:navegador": "node scripts/testar-navegador.mjs",
    "auditoria": "node scripts/auditoria/rodar-todas.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0"
  }
}
